* text=auto

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.shader text eol=lf
*.gdshader text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.xml text eol=lf
*.sh text eol=lf
# cmd.exe batch files keep CRLF (tests/runner_selftest/stub_godot.cmd; its self-test checks the bytes, TD-010).
*.cmd text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.dlg text eol=lf
*.py text eol=lf
.githooks/* text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.svg text eol=lf
*.mp3 binary
*.wav binary
*.ogg binary
*.zip binary

# Evidence logs are raw tool output kept verbatim (production/qa/evidence/README.md); trailing
# spaces in them are not a whitespace error (TD-003: CI runs git diff --check on every push).
production/qa/evidence/**/*.log -whitespace
