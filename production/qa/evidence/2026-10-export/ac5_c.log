        ForEach-Object { "$($_.Name) pid=$($_.ProcessId) parent=$($_.ParentProcessId)" })
    Write-Host ("DIAG {0}: started pid={1}; running: {2}" -f $Tag, $Proc.Id, $(if ($l.Count) { $l -join "; " } else { "none" }))
}

