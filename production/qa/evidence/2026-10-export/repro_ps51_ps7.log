Scripts: td022_repro.ps1 and td022_gap3.ps1 (inline below)
--- td022_repro.ps1
$log = Join-Path $env:TEMP "td022_repro.log"
foreach ($cache in $false, $true) {
    foreach ($code in 0, 3) {
        $p = Start-Process -FilePath "cmd.exe" -ArgumentList "/c ping -n 2 127.0.0.1 >nul & exit $code" -PassThru -NoNewWindow `
            -RedirectStandardOutput $log -RedirectStandardError "$log.err"
        if ($cache) { $null = $p.Handle }
        $done = $p.WaitForExit(10000)
        $ec = $p.ExitCode
        "cacheHandle=$cache want=$code done=$done ExitCode=[$ec] isNull=$($null -eq $ec)"
    }
}
"PS " + $PSVersionTable.PSVersion
--- td022_gap3.ps1 (EAP shown as Continue; the Stop run differs only in that line)
$ErrorActionPreference = "Continue"
$log = Join-Path $env:TEMP "td022_gap3.log"
$p = Start-Process -FilePath "cmd.exe" -ArgumentList "/c exit 0" -PassThru -NoNewWindow -RedirectStandardOutput $log -RedirectStandardError "$log.err"
$null = $p.Handle
$null = $p.WaitForExit(5000)
$null = & taskkill.exe /F /T /PID $p.Id 2>$null
"taskkill on exited PID: LASTEXITCODE=$LASTEXITCODE HasExited=$($p.HasExited)"
try { $p.Kill(); "Kill() on exited: no throw" } catch { "Kill() on exited: THROWS " + $_.Exception.GetType().Name }
