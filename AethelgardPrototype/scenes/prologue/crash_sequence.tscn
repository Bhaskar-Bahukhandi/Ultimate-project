[gd_scene load_steps=3 format=3 uid="uid://b7qvmxg4eqp2t"]

[ext_resource type="Script" path="res://scripts/prologue/crash_sequence.gd" id="1"]

[sub_resource type="Shader" id="Shader_glitch"]
code = "shader_type canvas_item;

uniform float glitch_strength : hint_range(0.0, 1.0) = 0.0;
uniform float time_offset = 0.0;

void fragment() {
	vec2 uv = UV;
	
	// Glitch displacement
	float glitch = sin(uv.y * 50.0 + TIME * 10.0 + time_offset) * glitch_strength;
	uv.x += glitch * 0.1;
	
	// Color separation
	vec4 col_r = texture(TEXTURE, uv + vec2(glitch_strength * 0.01, 0.0));
	vec4 col_g = texture(TEXTURE, uv);
	vec4 col_b = texture(TEXTURE, uv - vec2(glitch_strength * 0.01, 0.0));
	
	COLOR = vec4(col_r.r, col_g.g, col_b.b, col_g.a);
	
	// Scanlines
	float scanline = sin(uv.y * 800.0) * 0.04;
	COLOR.rgb -= scanline * glitch_strength;
	
	// Random pixelation
	if (glitch_strength > 0.5) {
		float noise = fract(sin(dot(floor(uv * 50.0), vec2(12.9898, 78.233))) * 43758.5453);
		if (noise > 0.95) {
			COLOR = vec4(0.0, 0.0, 0.0, 1.0);
		}
	}
}
"

