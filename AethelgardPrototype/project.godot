; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Aethelgard: The Glitch Sovereign"
config/description="A hybrid action-RPG prototype"
run/main_scene="res://scenes/splash_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputService="*res://scripts/core/input_service.gd"
GameManager="*res://scripts/game_manager.gd"
DialogueManager="*res://scripts/dialogue_manager.gd"
AssetManager="*res://scripts/asset_manager.gd"
Inventory="*res://scripts/inventory_system.gd"
CraftingSystem="*res://scripts/crafting_system.gd"
CombatFX="*res://scripts/combat_effects.gd"
GlitchOverlay="*res://scripts/glitch_overlay.gd"
VFXLibrary="*res://scripts/effects/vfx_library.gd"
PauseScreen="*res://scripts/ui/pause_screen.gd"
StatusWindow="*res://scripts/ui/status_window.gd"
InteractionPrompt="*res://scripts/ui/interaction_prompt.gd"
MusicManager="*res://scripts/music_manager.gd"
SceneTransitions="*res://scripts/effects/scene_transition_manager.gd"
ShopSystem="*res://scripts/shop_system.gd"
BackgroundManager="*res://scripts/background_manager.gd"
ObjectPool="*res://scripts/object_pool.gd"
LevelUpUI="*res://scripts/ui/level_up_ui.gd"
DropManager="*res://scripts/drop_manager.gd"
SFXManager="*res://scripts/sfx_manager.gd"
GameJuice="*res://scripts/effects/game_juice.gd"
Achievements="*res://scripts/ui/achievements.gd"
ChoiceConsequences="*res://scripts/choice_consequences.gd"
SideQuestManager="*res://scripts/side_quest_manager.gd"
ContextStack="*res://scripts/core/context_stack.gd"
RandomEncounterSystem="*res://scripts/combat/random_encounter_system.gd"
LoreJournal="*res://scripts/ui/lore_journal.gd"
WorldMapUI="*res://scripts/ui/world_map_ui.gd"
ProgressionBreadcrumb="*res://scripts/ui/progression_breadcrumb.gd"
CreditsScreen="*res://scripts/ui/credits_screen.gd"
CompletionTracker="*res://scripts/ui/completion_tracker.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

