# Windows reserved/device-name artifact.
/nul

# Temporary tool/session files.
**/tmpclaude-*-cwd

# Local editor settings.
/.vscode/

# Godot generated/editor cache.
**/.godot/
**/.import/

# Godot export output. export_presets.cfg IS tracked (builds must be
# reproducible); Godot 4 keeps credentials in .godot/export_credentials.cfg,
# which the .godot/ rule above already ignores.
export.cfg
AethelgardPrototype/exports/*
!AethelgardPrototype/exports/web/offline.html
AethelgardPrototype/run_artifacts/

# Logs from local tool / Godot runs (CI keeps its own).
*.log

# Mono/.NET generated files for Godot C# projects.
.mono/
data_*/
mono_crash.*.json
